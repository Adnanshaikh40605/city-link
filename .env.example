# Prisma CLI placeholder (must not contain spaces — runtime uses PG* vars below)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres?schema=public"

# Actual app database (name has a space: "city link")
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=city link

PORT=4000
JWT_SECRET=city-link-dev-secret-change-me
JWT_EXPIRES_IN=30d
NODE_ENV=development
EXPOSE_RESET_TOKEN=true
